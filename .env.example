# Required: Gemini API key used by gemini_subs.py and scripts/benchmark.py.
GEMINI_API_KEY=your_api_key_here

# Optional: Gemini-compatible proxy base URL.
# Leave unset to use the SDK default Google Gemini endpoint.
# GEMINI_API_BASE=https://main.your-proxy-domain.com/google/v1beta

# Optional: model for per-chunk video subtitle generation.
# GEMINI_MODEL=gemini-3.7-flash

# Optional: model for the global text refinement pass.
# GEMINI_REFINE_MODEL=gemini-3.1-pro-preview
